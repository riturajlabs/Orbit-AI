# =============================================
# Orbit AI - Backend Environment Variables
# Copy to .env and fill in real values.
# Never commit real secrets.
# =============================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/orbit_ai

# JWT Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI Provider (Groq primary)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# AI Service (Python FastAPI microservice)
# Render Python AI service
AI_SERVICE_URL=https://orbit-ai-service.onrender.com
# Must match AI_SERVICE_KEY in the AI service environment
AI_SERVICE_KEY=shared-secret-between-backend-and-ai-service

# Optional: AI service request timeout in milliseconds
AI_SERVICE_TIMEOUT_MS=20000

# Cloudinary (profile avatar uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloud_api_key
CLOUDINARY_API_SECRET=your_cloud_api_secret

# Frontend origin (used for CORS / client URLs)
CLIENT_URL=https://orbit-ai-client.vercel.app
