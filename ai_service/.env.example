# =============================================
# Orbit AI - AI Service (Python FastAPI)
# Copy to .env and fill in real values.
# Never commit real secrets.
# =============================================

# Primary LLM provider (Groq)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Fallback LLM provider (Gemini) - optional
# If left empty, the service runs with Groq only.
GEMINI_API_KEY=your_google_gemini_api_key

# MongoDB Atlas (required)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/orbit_ai

# Must match AI_SERVICE_KEY in the backend (Node) environment
AI_SERVICE_KEY=shared-secret-between-backend-and-ai-service
